def CST1 = preprocess_cst (parse json1)

def CST2 = preprocess_cst (parse json2)

def CST3 = preprocess_cst (parse json3)

def CST4 = preprocess_cst (parse json4)

def CST5 = preprocess_cst (parse json5)


-- ==
-- entry: main
-- compiled input { 0i64 }
-- compiled input { 1i64 }
-- compiled input { 2i64 }
-- compiled input { 3i64 }
-- compiled input { 4i64 }

entry main (x:i64) : i64 =
  let parsed_json = 
    match x
    case 0 -> (sorted_cst_to_JSON json1 (cst_by_depth CST1)).0
    case 1 -> (sorted_cst_to_JSON json2 (cst_by_depth CST2)).0
    case 2 -> (sorted_cst_to_JSON json3 (cst_by_depth CST3)).0
    case 3 -> (sorted_cst_to_JSON json4 (cst_by_depth CST4)).0
    case 4 -> (sorted_cst_to_JSON json5 (cst_by_depth CST5)).0
    case _ -> [#null]
  in
  match parsed_json[0]
  case #null -> 0
  case #bool b -> if b then 1 else 2
  case #num n -> n
  case #string (_, b) -> b
  case #list (_, b) -> b
  case #obj (_, _) (_, d) -> d


